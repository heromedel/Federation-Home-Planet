<configuration>
	<!--
		The console is only there when the station is started by hand (java -jar): the Interface opens it
		with javaw, and HomePlanet adds a log file per run (logs/), which is where its messages are read.
		Quiet by default: warnings and errors. Debug logging (Settings, Records, or debug_logging=true in
		federation-home-planet.cfg, or -Dhomeplanet.debug=true) keeps everything.
	-->
	<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%d{HH:mm:ss.SSS} %-5level %logger{0} - %msg%n</pattern>
		</encoder>
	</appender>

	<root level="WARN">
		<appender-ref ref="CONSOLE" />
	</root>
</configuration>
