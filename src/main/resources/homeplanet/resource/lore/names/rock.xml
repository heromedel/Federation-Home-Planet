<?xml version="1.0" encoding="UTF-8"?>
<!-- Rock crew names (docs/NAMES.md): rocks, not single crystals (those are the Crystal's, and the two lists share no
     names), preferably not plain English.

     sex: B (both), M or F, chosen by how a name sounds. A female crew member given a B name gets it with one of the
     endings in <female>, picked at random: ex="..." leaves out an ending that reads wrong on that name. A name already
     ending in one of them is its own female form; a final E drops before an ending that starts with a vowel (Pumice,
     Pumicite).
     rarity: where the name comes from (docs/NAMES.md): real rocks by how well known, then names from folk speech and
     myth, from one story, and made up here. A name comes up in proportion to its level's weight. No rarity is the first.

     To change them, copy this file into names in the lore folder beside the program and edit the copy. -->
<names race="rock">
	<rarity>
		<level name="Realworld" weight="1000"/>
		<level name="Realworld-Uncommon" weight="300"/>
		<level name="Realworld-Rare" weight="100"/>
		<level name="Semi-Fictional" weight="30"/>
		<level name="Known-Fiction" weight="10"/>
		<level name="Bizarre" weight="1"/>
	</rarity>
	<female suffix="ite, ine"/>

