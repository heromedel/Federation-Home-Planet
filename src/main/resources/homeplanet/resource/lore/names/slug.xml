<!-- Slug crew names (docs/NAMES.md): slimy words and a salesman's, sorted by hand into M and F, every one drawn out by
     the Slugs' six rules (the guide): soft consonants double, never an added R; no vowel drags but the one after SH;
     SH, TH, CH and PH never double; no three doubles in a row; an S or soft C doubles only when the letter after it
     does; hard stops never double.

     from="..." is the plain word the name was drawn out from, for the curious (and the test, which draws it out again
     and checks they agree). The station uses the name.
     rarity: a level of the ladder below; a name comes up in proportion to its level's weight. No rarity is the first.

     To change them, copy this file into names in the lore folder beside the program and edit the copy. -->
<names race="slug">
	<rarity>
		<level name="common" weight="1000"/>
		<level name="uncommon" weight="300"/>
		<level name="rare" weight="100"/>
		<level name="very-rare" weight="30"/>
		<level name="highly-unusual" weight="10"/>
		<level name="almost-unique" weight="1"/>
	</rarity>

